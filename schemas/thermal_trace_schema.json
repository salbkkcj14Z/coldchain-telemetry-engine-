{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["headers", "payload"],
  "properties": {
    "headers": {
      "type": "object",
      "required": ["Authorization"],
      "properties": {
        "Authorization": { "type": "string" }
      }
    },
    "payload": {
      "type": "object",
      "required": ["shipment_id", "timestamp_utc", "telemetry", "commercial_reserve"],
      "properties": {
        "shipment_id": { "type": "string" },
        "timestamp_utc": { "type": "string" },
        "telemetry": {
          "type": "object",
          "properties": {
            "ambient_temp_c": { "type": "number" },
            "core_cargo_temp_c": { "type": "number" },
            "humidity_pct": { "type": "number" },
            "refrigeration_power_status": { "type": "string" }
          }
        },
        "commercial_reserve": {
          "type": "object",
          "properties": {
            "shelf_life_remaining_hours": { "type": "number" },
            "thermal_integrity_score": { "type": "number" },
            "containment_status": { "type": "string" }
          }
        }
      }
    }
  }
}
